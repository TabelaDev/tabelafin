ORIGIN="http://localhost:5173"

# Worker secret p/ AES-GCM (envelope encryption de ai_credentials e
# pluggy_credentials). >=32 chars.
# Em prod: wrangler secret put MASTER_KEY
MASTER_KEY="troque-por-um-segredo-aleatorio-de-32+chars"

# Notificação de relatório mensal pronto via Web Push (ESCOPO.md §3.6) —
# VAPID (RFC 8292). VAPID_PUBLIC_KEY e VAPID_SUBJECT já estão em
# wrangler.jsonc (não são segredo). VAPID_PRIVATE_KEY é o segredo real, mesmo
# padrão do MASTER_KEY: só em .dev.vars localmente, nunca commitado.
# Gere um par novo com:
#   node -e "crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign','verify']).then(async k=>{const pub=new Uint8Array(await crypto.subtle.exportKey('raw',k.publicKey));const priv=await crypto.subtle.exportKey('jwk',k.privateKey);const b64u=b=>Buffer.from(b).toString('base64url');console.log('VAPID_PUBLIC_KEY='+b64u(pub));console.log('VAPID_PRIVATE_KEY='+priv.d)})"
# O VAPID_PUBLIC_KEY gerado precisa bater com o que está em wrangler.jsonc
# (senão o browser assina a subscription com uma chave e o servidor assina o
# JWT com outra). Em prod: wrangler secret put VAPID_PRIVATE_KEY
VAPID_PRIVATE_KEY="troque-pela-chave-privada-vapid-gerada-acima"

# Better Auth (src/lib/server/auth/index.ts): secret pra sessões e CSRF.
# >=32 chars. Gerar com: openssl rand -base64 32
# Em prod: wrangler secret put BETTER_AUTH_SECRET
BETTER_AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32+chars"

# URL base do Better Auth (usado pra callbacks de sessão).
# Em prod: a URL do worker deployado.
BETTER_AUTH_URL="http://localhost:5173"
