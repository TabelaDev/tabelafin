{
	"manifest_version": 3,
	"name": "TAbelhaFin — Bridge do Meu Pluggy",
	"version": "0.1.0",
	"description": "Captura o token do Meu Pluggy e sincroniza automaticamente com o TAbelhaFin.",
	"permissions": ["storage"],
	"host_permissions": [
		"https://meu.pluggy.ai/*",
		"https://tabelhafin.tabelhadev.workers.dev/*",
		"https://tabelhafin-staging.tabelhadev.workers.dev/*"
	],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["https://meu.pluggy.ai/*"],
			"js": ["content.js"],
			"run_at": "document_start",
			"world": "MAIN"
		}
	],
	"action": {
		"default_popup": "popup.html",
		"default_title": "TAbelhaFin",
		"default_icon": { "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
	},
	"icons": { "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
