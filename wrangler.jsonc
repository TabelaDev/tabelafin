{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tabelafin",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": "worker/entry.js",
	"alias": {
		"$lib": "./src/lib",
		// typst.ts WASM modules only run client-side (via CDN).
		// On the server, we map them to empty modules to avoid resolution errors.
		"@myriaddreamin/typst-ts-web-compiler": "./worker/empty-module.js",
		"@myriaddreamin/typst-ts-renderer": "./worker/empty-module.js"
	},
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"workers_dev": true,
	// Preview URLs are off: each deploy would otherwise publish a second public
	// hostname bound to the SAME production D1 and KV, outside any custom domain
	// or WAF, and with BETTER_AUTH_URL pointing at a different origin than the
	// one being served.
	"preview_urls": false,
	// Workers Logs. Without this the ~20 console.error calls in the sync, the
	// report cron and the AI paths go nowhere: a nightly cron that fails for
	// every user leaves no trace, which is exactly the failure this app is
	// prone to. 100% sampling — the request volume is tiny.
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"ORIGIN": "https://tabelafin.ianptkcs-023.workers.dev",
		"PUBLIC_TABELAUTH_URL": "https://tabelaauth.ianptkcs-023.workers.dev",
		"PUBLIC_APP_URL": "https://tabelafin.ianptkcs-023.workers.dev",
		"VAPID_PUBLIC_KEY": "BLRtiZgDBYkAVW92C0WIfRmlehgF0g4vI7i6xC8VKYHziKVdcyxv3jtj0BIoin5LU255BX4pknqJENcPfswYAns",
		"VAPID_SUBJECT": "https://tabelafin.ianptkcs-023.workers.dev",
		// Better Auth: base URL for session callbacks
		"BETTER_AUTH_URL": "https://tabelafin.ianptkcs-023.workers.dev",
		// From address for the verification / password-reset e-mails. A var and
		// not a secret — it is public by definition, it appears in every message
		// sent. **Brevo will not deliver from an unverified sender**, so this
		// address has to be verified in the Brevo account (a single address is
		// enough; a whole domain is not required). Change it to an address on the
		// custom domain once there is one — see "Domínio custom" in AGENTS.md.
		"EMAIL_FROM": "ianptkcs@gmail.com"
		// Secrets (not committed): BETTER_AUTH_SECRET, MASTER_KEY, VAPID_PRIVATE_KEY
		// Configured via `wrangler secret put <NAME>`
	},
	// Daily cron (Pluggy sync: accounts/transactions/investments) + monthly cron
	// (day 1, previous month report + push) — see ESCOPO.md §3.2/§3.6.
	// The `scheduled` handler in worker/entry.js distinguishes the two via `event.cron`.
	"triggers": { "crons": ["0 6 * * *", "0 7 1 * *"] },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tabelafin-db",
			"database_id": "08a3cf81-b376-41ab-b41d-21a0778f3257",
			"migrations_dir": "drizzle"
		}
	],
	"kv_namespaces": [{ "binding": "SESSIONS", "id": "34086589c9b34c1ab5c5b59e236662f0" }],
	// Staging: isolated resources (own D1/KV, vars pointing to staging subdomain),
	// no crons — manual trigger from the dashboard for testing.
	// Secrets via `wrangler secret put <NAME> --env staging`.
	"env": {
		"staging": {
			"name": "tabelafin-staging",
			// Environments inherit `triggers.crons` from top-level; empty list zeroes them out
			// (staging has no cron — manual trigger from the dashboard for testing).
			"triggers": { "crons": [] },
			"vars": {
				"ORIGIN": "https://tabelafin-staging.ianptkcs-023.workers.dev",
				"VAPID_PUBLIC_KEY": "BNGg4bHjsBjz2tVbuoyGXAaBMmbaUbKgYizkf82DAYVO3hBWm7nNSghb6qx0hDYjn-N_lHN6RHaqSeoRkc5ZtH8",
				"VAPID_SUBJECT": "https://tabelafin-staging.ianptkcs-023.workers.dev",
				"BETTER_AUTH_URL": "https://tabelafin-staging.ianptkcs-023.workers.dev",
				"EMAIL_FROM": "ianptkcs@gmail.com"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "tabelafin-db-staging",
					"database_id": "1eda2c73-fc28-4dbc-a4cb-9b7852f4f168",
					"migrations_dir": "drizzle"
				}
			],
			"kv_namespaces": [{ "binding": "SESSIONS", "id": "678a10fb88e74c74b7d2ebdc59ef356c" }]
		}
	}
}
